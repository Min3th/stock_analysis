# Copy to web/.env. Everything here is local; nothing is exposed beyond 127.0.0.1.

# Python interpreter that runs main.py (must have the project installed).
PYTHON_BIN=python
# Repository root (contains main.py, config/, data/, reports/). Default: two levels up from web/api.
REPO_ROOT=..
# Express API.
API_PORT=4000
# Origin(s) of the Next.js app that may call the API, comma separated.
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
# Upload size limit in megabytes (PDF only).
UPLOAD_LIMIT_MB=50
# Where the API keeps its SQLite index, uploads in progress and job logs.
WEB_DATA_DIR=./data
# URL the Next.js app proxies /api to.
API_URL=http://127.0.0.1:4000
